# =============================================================================
# .env.example — Plantilla de variables de entorno para NeuroMedIR
#
# Copiar a .env y rellenar con las claves reales. El archivo .env NO se incluye
# en la imagen (está en .dockerignore) y se inyecta en runtime vía docker-compose.
#
# Sin claves, el sistema sigue funcionando en modo degradado: la recuperación
# opera con normalidad, pero la generación RAG y la búsqueda web quedan limitadas.
# =============================================================================

# Generación RAG — proveedor principal (OpenRouter, modelo gpt-4o-mini)
OPENROUTER_API_KEY=

# Generación RAG — proveedor de respaldo (Google Gemini 2.5-flash)
GEMINI_API_KEY=

# Búsqueda web dinámica (SerpApi)
SERPAPI_API_KEY=
