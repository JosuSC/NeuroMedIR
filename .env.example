# ============================================================================
# NeuroMedIR Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values.
# This file should NOT be committed to version control.
#
# To use: cp .env.example .env
# Then edit .env with your actual API key.
# ============================================================================

# ---------------------------------------------------------------------------
# Google Gemini API Configuration
# ---------------------------------------------------------------------------
# Required to enable RAG (Retrieval-Augmented Generation) with Gemini.
# Get your free API key at: https://ai.google.dev/
#
# The client will also check GOOGLE_API_KEY as fallback.
GEMINI_API_KEY=your_api_key_here

# Optional: Override the default Gemini model (defaults to gemini-2.5-flash)
# Available models: gemini-2.5-flash, gemini-2.5-pro, gemini-2.0-flash, etc.
# GEMINI_MODEL=gemini-2.5-flash

# Optional: Request timeout in seconds for Gemini API calls
# GEMINI_REQUEST_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Aplicación
# ---------------------------------------------------------------------------
# Set to 'development', 'staging', or 'production'
# ENVIRONMENT=development

# Port for FastAPI backend (default: 8000)
# PORT=8000

# Frontend dev server port (default: 5173 for Vite)
# FRONTEND_PORT=5173
